rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is superAdmin
    function isSuperAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin';
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;  // Anyone can read categories (no login required)
      allow write: if isSuperAdmin();  // Only superAdmin can create/update/delete
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;  // Anyone can read products (no login required)
      allow write: if isSuperAdmin();  // Only superAdmin can create/update/delete
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if request.auth !=  null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;  // No direct writes (managed by backend)
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}